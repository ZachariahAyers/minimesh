{
  "name": "minimesh",
  "version": "0.0.1-4",
  "description": "",
  "keywords": [
    "Micro-Frontends",
    "Framework",
    "SSR",
    "SSG",
    "API",
    "Islands"
  ],
  "homepage": "",
  "bugs": "",
  "repository": {
    "type": "git",
    "url": "",
    "description": "",
    "homepage": "",
    "name": "",
    "owner": "",
    "private": "true"
  },
  "license": "MIT",
  "author": "Zach Ayers",
  "maintainers": [
    "Zach Ayers"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "mesh-build": "./lib/bundler/mesh.build.js",
    "mesh-generate": "./lib/generator/mesh.generate.js",
    "mesh-insights": "./lib/analyzer/page-speed-insights/mesh.insights.js",
    "mesh-serve": "./lib/bundler/mesh.serve.js",
    "meshgen": "./lib/generator/mesh.generate.js"
  },
  "files": [
    "lib/**/*"
  ],
  "scripts": {
    "prepack": "yarn build",
    "changelog": "auto-changelog",
    "commit": "cz",
    "docs": "typedoc --options typedoc.json",
    "docs:serve": "serve -l 8899 -s ./documentation",
    "build": "run-s build:ts build:client copy:templates copy:assets docs",
    "build:dry": "tsc --build --dry",
    "build:ts": "yarn clean && tsc --build --verbose && yarn build:ts-add-js-extension",
    "build:ts:debug": "yarn clean && tsc --build --verbose",
    "build:ts-add-js-extension": "ts-add-js-extension add --dir=lib --showchanges=false",
    "build:ts-add-js-extension:debug": "ts-add-js-extension add --dir=lib --showchanges=true",
    "build:client": "vite build",
    "check": "tsc --noEmit",
    "clean": "run-s clean:*",
    "format": "run-s format:*",
    "generate": "run-p generate:*",
    "test": "jest --passWithNoTests",
    "test:all": "run-p test:*",
    "prepare": "npx husky install",
    "watch:templates": "nodemon --watch ./src/generator/templates/* --exec \"yarn copy:templates\"",
    "watch:client": "vite build --mode=watch",
    "copy:templates": "shx cp -r ./src/generator/templates ./lib/generator",
    "copy:assets": "shx cp -r ./src/assets ./lib/bundles/assets",
    "generate:module-graph": "depcruise --config .dependency-cruiser.cjs src -T dot src | dot -T svg | depcruise-wrap-stream-in-html > ./reports/dependencygraph.html",
    "clean:tgz": "rimraf minimesh-*.tgz",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:examples": "rimraf ./examples/*/node_modules ./examples/*/yarn.lock",
    "clean:docs": "rimraf docs",
    "lint:dry": "eslint src/**/*",
    "lint:fix": "eslint --fix src/**/*",
    "lint:sort": "npx sort-package-json",
    "lint:pretty": "prettier --write src/**/* !**/*.gitkeep",
    "lint:staged": "lint-staged",
    "lint:modules": "depcruise --config .dependency-cruiser.cjs src",
    "lint:deps": "npx depcheck",
    "lint:types": "npx typesync",
    "lint:all": "run-s lint:sort lint:pretty lint:fix lint:modules",
    "update:check": "npx npm-check-updates",
    "update:major": "yarn update:check -- -u",
    "update:minor": "yarn update:check -- --target minor -u",
    "update:patch": "yarn update:check -- --target patch -u",
    "reboot": "yarn clean && yarn pack && run-s reboot:*",
    "reboot:global": "npm i -g minimesh-v$npm_package_version.tgz --no-cache --check-files --offline",
    "reboot:examples": "run-s install:examples:*",
    "install:examples:simple-preprocessor": "cd examples/simple-preprocessor-example && yarn add \"file:./../../minimesh-v$npm_package_version.tgz\" --check-files --offline",
    "install:examples:multi-ui-language-example": "cd examples/multi-ui-language-example && yarn add \"file:./../../minimesh-v$npm_package_version.tgz\" --check-files --offline",
    "install:examples:advanced-preact-example": "cd examples/advanced-preact-example && yarn add \"file:./../../minimesh-v$npm_package_version.tgz\" --check-files --offline",
    "git:update": "git add . && git commit -m \"chore: update\" && git push",
    "git:update:force": "git add . && git commit -m \"chore: update\" && git push --force"
  },
  "husky": {
    "hooks": {
      "prepare-commit-msg": "exec < /dev/tty && npx cz --hook || true"
    }
  },
  "lint-staged": {
    "*.+(ts|json|md)": [
      "prettier --write"
    ],
    "*.+(ts|tsx)": [
      "eslint --fix"
    ]
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "reporters": [
      "default",
      [
        "jest-junit",
        {
          "usePathForSuiteName": "true",
          "classNameTemplate": "{filepath}"
        }
      ]
    ],
    "roots": [
      "<rootDir>/src/"
    ],
    "testEnvironment": "node"
  },
  "dependencies": {
    "@babel/plugin-transform-react-jsx": "^7.18.10",
    "@babel/plugin-transform-react-jsx-development": "^7.18.6",
    "@fastify/auth": "^3.0.2",
    "@fastify/basic-auth": "^4.0.0",
    "@fastify/compress": "^6.1.0",
    "@fastify/cors": "^8.0.0",
    "@fastify/helmet": "^9.1.0",
    "@fastify/routes": "^5.0.0",
    "@fastify/static": "^6.5.0",
    "@fastify/swagger": "^7.4.0",
    "@preact/preset-vite": "^2.3.0",
    "@sentry/node": "^7.2.0",
    "@sinclair/typebox": "0.23.5",
    "@types/jsonfile": "^6.1.0",
    "@vavite/expose-vite-dev-server": "^1.4.1",
    "@vavite/reloader": "^1.4.1",
    "@vitejs/plugin-legacy": "^2.0.0",
    "ajv": "8.11.0",
    "ajv-formats": "2.1.1",
    "axios": "0.27.2",
    "babelify": "^10.0.0",
    "browserify": "^17.0.0",
    "chalk": "^5.0.1",
    "date-and-time": "2.3.1",
    "ejs": "^3.1.8",
    "fastify": "4.0.3",
    "fs-extra": "10.1.0",
    "glob": "^8.0.3",
    "highlight.js": "^11.6.0",
    "inquirer": "^9.1.0",
    "jsonfile": "^6.1.0",
    "lighthouse": "9.6.2",
    "markdown-it": "^13.0.1",
    "minimist": "^1.2.6",
    "node-html-parser": "^5.3.3",
    "open": "8.4.0",
    "pino-pretty": "^9.0.1",
    "plop": "^3.1.1",
    "point-of-view": "6.3.0",
    "preact": "^10.10.3",
    "preact-render-to-string": "^5.2.2",
    "rimraf": "^3.0.2",
    "sass": "^1.54.4",
    "typescript": "^4.7.4",
    "ua-parser-js": "1.0.2",
    "vavite": "^1.4.1",
    "vite": "^3.0.4",
    "vite-plugin-live-reload": "^3.0.0",
    "yargs": "17.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^17.0.3",
    "@commitlint/config-conventional": "^17.0.3",
    "@types/babelify": "^7.3.7",
    "@types/browserify": "^12.0.37",
    "@types/date-and-time": "0.13.0",
    "@types/ejs": "^3.1.1",
    "@types/fs-extra": "9.0.13",
    "@types/glob": "^7.2.0",
    "@types/jest": "^28.1.2",
    "@types/livereload": "^0.9.2",
    "@types/markdown-it": "^12.2.3",
    "@types/minimist": "^1.2.2",
    "@types/node": "18.0.0",
    "@types/rimraf": "^3.0.2",
    "@types/ua-parser-js": "^0.7.36",
    "@types/yargs": "17.0.10",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "auto-changelog": "^2.4.0",
    "concurrently": "^7.3.0",
    "cz-conventional-changelog": "^3.3.0",
    "dependency-cruiser": "^11.10.0",
    "eslint": "8.18.0",
    "eslint-config-google": "0.14.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-plugin-prettier": "4.0.0",
    "husky": "8.0.1",
    "jest": "^28.1.1",
    "jest-junit": "^13.2.0",
    "lint-staged": "13.0.2",
    "node": "18.4.0",
    "nodemon": "^2.0.19",
    "npm-run-all": "4.1.5",
    "prettier": "2.7.1",
    "replace-in-file": "^6.3.5",
    "serve": "^14.0.1",
    "shx": "^0.3.4",
    "terser": "^5.14.2",
    "ts-add-js-extension": "^1.2.1",
    "typedoc": "^0.23.10",
    "typedoc-gitlab-wiki-theme": "^1.0.0",
    "typedoc-plugin-extras": "^2.3.0",
    "typedoc-plugin-markdown": "^3.13.4",
    "typedoc-plugin-merge-modules": "^4.0.1",
    "typedoc-plugin-mermaid": "^1.9.0",
    "yarn": "^1.22.19"
  },
  "auto-changelog": {
    "output": "CHANGELOG.md",
    "unreleased": true,
    "commitLimit": false,
    "sortCommits": "date-desc"
  },
  "readme": ""
}
